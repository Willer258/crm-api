{
	"info": {
		"_postman_id": "crm-api-collection-2025",
		"name": "CRM API - Complete Collection",
		"description": "Collection complète pour l'API CRM Symfony 7.2 avec multi-tenancy.\n\n## Variables d'environnement recommandées:\n- `baseUrl`: URL de base de l'API (ex: http://localhost:8000)\n- `token`: Token JWT pour l'authentification\n- `apiKey`: Clé API pour les services\n- `tenant`: Nom du tenant actif\n\n## Authentification:\n- JWT: Header `Authorization: Bearer {{token}}`\n- API Key: Header `X-API-KEY: {{apiKey}}`\n- Tenant: Header `X-Tenant: {{tenant}}`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [

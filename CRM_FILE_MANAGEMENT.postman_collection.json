{
	"info": {
		"_postman_id": "file-mgmt-2024-12-10",
		"name": "CRM API - File Management",
		"description": "Collection Postman pour tester la gestion de fichiers avec chunked upload dans le CRM API\n\nBase URL: http://crm-api.test\n\n## Authentification\nToutes les requêtes nécessitent un token JWT dans le header Authorization.\n\n## Variables d'environnement requises\n- `base_url`: http://crm-api.test\n- `jwt_token`: Token JWT obtenu après login\n- `workspace_id`: ID du workspace actif\n\n## Fonctionnalités\n- Upload simple de fichiers\n- Upload par morceaux (chunked upload)\n- Liste des fichiers du workspace\n- Configuration d'upload\n- Suppression de fichiers",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://crm-api.test",
			"type": "string"
		},
		{
			"key": "workspace_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.token) {",
									"        pm.collectionVariables.set('jwt_token', response.token);",
									"        console.log('Token JWT sauvegardé:', response.token);",
									"    }",
									"    if (response.user && response.user.currentWorkspace) {",
									"        pm.collectionVariables.set('workspace_id', response.user.currentWorkspace.id);",
									"        console.log('Workspace ID sauvegardé:', response.user.currentWorkspace.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Connexion pour obtenir le token JWT"
					},
					"response": []
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/user/profile",
							"host": ["{{base_url}}"],
							"path": ["user", "profile"]
						},
						"description": "Récupère le profil utilisateur et le workspace actif"
					},
					"response": []
				}
			]
		},
		{
			"name": "2. File Upload - Simple",
			"item": [
				{
					"name": "Upload File (Simple)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Workspace-Id",
								"value": "{{workspace_id}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								},
								{
									"key": "contact",
									"value": "1",
									"type": "text",
									"disabled": true
								},
								{
									"key": "company",
									"value": "1",
									"type": "text",
									"disabled": true
								},
								{
									"key": "deal",
									"value": "1",
									"type": "text",
									"disabled": true
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/file/upload",
							"host": ["{{base_url}}"],
							"path": ["file", "upload"]
						},
						"description": "Upload simple d'un fichier (sans chunking). Supporte l'association optionnelle avec Contact, Company ou Deal."
					},
					"response": []
				},
				{
					"name": "Get Upload Config",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Workspace-Id",
								"value": "{{workspace_id}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/file/config",
							"host": ["{{base_url}}"],
							"path": ["file", "config"]
						},
						"description": "Récupère la configuration d'upload (taille max, types MIME autorisés)"
					},
					"response": []
				}
			]
		},
		{
			"name": "3. File Upload - Chunked",
			"item": [
				{
					"name": "Chunked Upload - Chunk 1",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Génération d'un ID unique pour ce fichier",
									"const uniqId = Date.now() + '-' + Math.random().toString(36).substr(2, 9);",
									"pm.collectionVariables.set('file_uniq_id', uniqId);",
									"",
									"// Simulation d'un fichier de 5MB (chunk de 2MB chacun)",
									"const fileSize = 5 * 1024 * 1024; // 5MB",
									"const chunkSize = 2 * 1024 * 1024; // 2MB",
									"const totalChunks = Math.ceil(fileSize / chunkSize); // 3 chunks",
									"",
									"pm.collectionVariables.set('file_size', fileSize);",
									"pm.collectionVariables.set('chunk_size', chunkSize);",
									"pm.collectionVariables.set('total_chunks', totalChunks);",
									"",
									"console.log('File upload initialized:');",
									"console.log('- Unique ID:', uniqId);",
									"console.log('- File Size:', fileSize, 'bytes');",
									"console.log('- Chunk Size:', chunkSize, 'bytes');",
									"console.log('- Total Chunks:', totalChunks);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Workspace-Id",
								"value": "{{workspace_id}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"loaded\": 0,\n    \"fileName\": \"example-document.pdf\",\n    \"fileSize\": {{file_size}},\n    \"fileType\": \"application/pdf\",\n    \"fileHash\": \"abc123def456\",\n    \"uniqId\": \"{{file_uniq_id}}\",\n    \"chunk\": \"data:application/pdf;base64,JVBERi0xLjQKJeLjz9MKMyAwIG9iago8PC9UeXBlL1BhZ2UvUGFyZW50IDIgMCBSL1Jlc291cmNlczw8L0ZvbnQ8PC9GMSA1IDAgUj4+Pj4vTWVkaWFCb3hbMCAwIDYxMiA3OTJdL0NvbnRlbnRzIDQgMCBSPj4KZW5kb2JqCg==\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/file/uploader",
							"host": ["{{base_url}}"],
							"path": ["file", "uploader"]
						},
						"description": "Upload du premier chunk (loaded=0). Le chunk est encodé en base64."
					},
					"response": []
				},
				{
					"name": "Chunked Upload - Chunk 2",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Workspace-Id",
								"value": "{{workspace_id}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"loaded\": 1,\n    \"fileName\": \"example-document.pdf\",\n    \"fileSize\": {{file_size}},\n    \"fileType\": \"application/pdf\",\n    \"fileHash\": \"abc123def456\",\n    \"uniqId\": \"{{file_uniq_id}}\",\n    \"chunk\": \"data:application/pdf;base64,SGVsbG8gV29ybGQhIFRoaXMgaXMgY2h1bmsgMg==\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/file/uploader",
							"host": ["{{base_url}}"],
							"path": ["file", "uploader"]
						},
						"description": "Upload du deuxième chunk (loaded=1)"
					},
					"response": []
				},
				{
					"name": "Chunked Upload - Chunk 3 (Final)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.status === 'finished' && response.id) {",
									"        pm.collectionVariables.set('uploaded_file_uuid', response.id);",
									"        console.log('File uploaded successfully!');",
									"        console.log('UUID:', response.id);",
									"        console.log('Filename:', response.filename);",
									"        console.log('Link:', response.link);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Workspace-Id",
								"value": "{{workspace_id}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"loaded\": 2,\n    \"fileName\": \"example-document.pdf\",\n    \"fileSize\": {{file_size}},\n    \"fileType\": \"application/pdf\",\n    \"fileHash\": \"abc123def456\",\n    \"uniqId\": \"{{file_uniq_id}}\",\n    \"chunk\": \"data:application/pdf;base64,RmluYWwgY2h1bmsgb2YgdGhlIGZpbGU=\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/file/uploader",
							"host": ["{{base_url}}"],
							"path": ["file", "uploader"]
						},
						"description": "Upload du dernier chunk (loaded=2). Le serveur fusionne tous les chunks et retourne le fichier complet."
					},
					"response": []
				}
			],
			"description": "Upload par morceaux pour les gros fichiers. Chaque chunk est envoyé séquentiellement avec un numéro d'ordre (loaded)."
		},
		{
			"name": "4. File Management",
			"item": [
				{
					"name": "List Files",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.length > 0) {",
									"        const firstFile = response.data[0];",
									"        pm.collectionVariables.set('file_id', firstFile.id);",
									"        console.log('Premier fichier trouvé:');",
									"        console.log('- ID:', firstFile.id);",
									"        console.log('- Name:', firstFile.name);",
									"        console.log('- Type:', firstFile.type);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Workspace-Id",
								"value": "{{workspace_id}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/file/list",
							"host": ["{{base_url}}"],
							"path": ["file", "list"]
						},
						"description": "Liste tous les fichiers du workspace actif"
					},
					"response": []
				},
				{
					"name": "Delete File",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "X-Workspace-Id",
								"value": "{{workspace_id}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/file/delete/{{file_id}}",
							"host": ["{{base_url}}"],
							"path": ["file", "delete", "{{file_id}}"]
						},
						"description": "Supprime un fichier. Vérifie que le fichier appartient au workspace actif."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Workspace Management",
			"item": [
				{
					"name": "List Workspaces",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.length > 0) {",
									"        const firstWorkspace = response.data[0];",
									"        pm.collectionVariables.set('workspace_id', firstWorkspace.id);",
									"        console.log('Workspace actif:', firstWorkspace.name, '(ID:', firstWorkspace.id + ')');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/workspace/list",
							"host": ["{{base_url}}"],
							"path": ["workspace", "list"]
						},
						"description": "Liste tous les workspaces de l'utilisateur"
					},
					"response": []
				},
				{
					"name": "Switch Workspace",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.status === 'success') {",
									"        console.log('Workspace switched successfully');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"workspaceId\": {{workspace_id}}\n}"
						},
						"url": {
							"raw": "{{base_url}}/workspace/switch",
							"host": ["{{base_url}}"],
							"path": ["workspace", "switch"]
						},
						"description": "Change le workspace actif de l'utilisateur"
					},
					"response": []
				}
			]
		},
		{

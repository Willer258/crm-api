<div class="flex flex-col h-full">
    <!-- Logo -->
    <div class="px-6 py-6 border-b">
        <h2 class="text-2xl font-bold text-blue-600">CRM SaaS</h2>
        <p class="text-sm text-gray-500">Super Admin</p>

{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard Super Admin{% endblock %}

{% block body %}
<div class="space-y-6" data-controller="admin--dashboard">
    <!-- KPI Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Total Tenants -->
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Total Tenants</p>
                    <p class="text-3xl font-bold text-gray-900">{{ overview.total_tenants ?? 0 }}</p>
                    <p class="text-xs text-green-600 mt-2">
                        +{{ overview.new_tenants_this_month ?? 0 }} ce mois
                    </p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Active Subscriptions -->
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600 mb-1">Abonnements Actifs</p>
                    <p class="text-3xl font-bold text-gray-900">{{ overview.active_subscriptions ?? 0 }}</p>
                    <p class="text-xs text-gray-600 mt-2">
                        {{ ((overview.active_subscriptions ?? 0) / (overview.total_tenants ?? 1) * 100)|round(1) }}% du total
                    </p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- MRR -->
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600 mb-1">MRR</p>
                    <p class="text-3xl font-bold text-gray-900">{{ (metrics.mrr ?? 0)|number_format(0, ',', ' ') }} €</p>
                    <p class="text-xs text-green-600 mt-2">
                        +{{ (metrics.mrr_growth_rate ?? 0)|round(1) }}% ce mois
                    </p>
                </div>
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- ARR -->
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600 mb-1">ARR</p>
                    <p class="text-3xl font-bold text-gray-900">{{ (metrics.arr ?? 0)|number_format(0, ',', ' ') }} €</p>
                    <p class="text-xs text-gray-600 mt-2">
                        Revenu annuel récurrent
                    </p>
                </div>
                <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Revenue Chart -->
        <div class="card">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Évolution MRR</h3>
            <div class="h-64">
                <canvas
                    id="mrrChart"
                    data-admin--dashboard-target="mrrChart"
                    data-chart-data="{{ metrics.mrr_trend ?? '[]'|json_encode }}"
                ></canvas>
            </div>
        </div>

        <!-- Tenant Growth Chart -->
        <div class="card">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Croissance Tenants</h3>
            <div class="h-64">
                <canvas
                    id="tenantGrowthChart"
                    data-admin--dashboard-target="tenantChart"
                    data-chart-data="{{ overview.tenant_growth ?? '[]'|json_encode }}"
                ></canvas>
            </div>
        </div>
    </div>

    <!-- Additional Metrics -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Churn Rate -->
        <div class="card">
            <div class="flex items-center justify-between mb-3">
                <h4 class="text-sm font-medium text-gray-700">Taux de Churn</h4>
                <span class="badge badge-{{ (metrics.churn_rate ?? 0) > 5 ? 'danger' : 'success' }}">
                    {{ (metrics.churn_rate ?? 0)|round(2) }}%
                </span>
            </div>
            <p class="text-2xl font-bold text-gray-900">{{ (metrics.churned_customers ?? 0) }} clients</p>
            <p class="text-xs text-gray-500 mt-1">Ce mois</p>
        </div>

        <!-- LTV -->
        <div class="card">
            <div class="flex items-center justify-between mb-3">
                <h4 class="text-sm font-medium text-gray-700">LTV Moyen</h4>
                <span class="badge badge-info">Lifetime Value</span>
            </div>
            <p class="text-2xl font-bold text-gray-900">{{ (metrics.ltv ?? 0)|number_format(0, ',', ' ') }} €</p>
            <p class="text-xs text-gray-500 mt-1">Par client</p>
        </div>

        <!-- CAC -->
        <div class="card">
            <div class="flex items-center justify-between mb-3">
                <h4 class="text-sm font-medium text-gray-700">CAC</h4>
                <span class="badge badge-warning">Cost</span>
            </div>
            <p class="text-2xl font-bold text-gray-900">{{ (metrics.cac ?? 0)|number_format(0, ',', ' ') }} €</p>
            <p class="text-xs text-gray-500 mt-1">
                Ratio LTV:CAC = {{ (metrics.ltv_cac_ratio ?? 0)|round(1) }}
            </p>
        </div>
    </div>

    <!-- Recent Activity Table -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-semibold text-gray-900">Activité Récente</h3>
            <a href="{{ path('admin_tenants_list') }}" class="text-sm text-blue-600 hover:text-blue-700">
                Voir tout →
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tenant</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Plan</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Statut</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">MRR</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Créé</th>
                    </tr>
                </thead>
                <tbody>
                    {% if overview.recent_tenants is defined %}
                        {% for tenant in overview.recent_tenants|slice(0, 10) %}
                            <tr class="table-row">
                                <td class="px-4 py-3">
                                    <a href="{{ path('admin_tenant_detail', {tenantId: tenant.tenant_id}) }}" class="text-blue-600 hover:text-blue-700 font-medium">
                                        {{ tenant.tenant_id }}
                                    </a>
                                </td>
                                <td class="px-4 py-3 text-sm text-gray-600">{{ tenant.plan_name ?? 'N/A' }}</td>
                                <td class="px-4 py-3">
                                    <span class="badge badge-{{ tenant.status == 'active' ? 'success' : 'secondary' }}">
                                        {{ tenant.status|capitalize }}
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-sm font-medium text-gray-900">{{ (tenant.mrr ?? 0)|number_format(0, ',', ' ') }} €</td>
                                <td class="px-4 py-3 text-sm text-gray-600">{{ tenant.created_at|date('d/m/Y') }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-4 py-8 text-center text-gray-500">
                                Aucune activité récente
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
